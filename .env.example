# Required — Supabase project
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional — Stripe. Leave unset to run payment UI in sandbox/demo mode.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional — OAuth provider buttons on the auth page. Only set 'true' once the
# provider is actually configured in Supabase Auth → Providers.
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_APPLE_AUTH=false

# Optional — Company Copilot panel (Company OS).
VITE_ENABLE_COPILOT=false
# Web Push (optional � push notifications flag-gated when unset)
VITE_VAPID_PUBLIC_KEY=

# Optional — LLM backend for Copilot + import mapping. Default calls the
# llm-proxy edge function (server-side upstream + API key). For local dev
# against OmniRoute/llama.cpp, set this to the OpenAI-compatible base URL
# to bypass the proxy entirely, e.g.:
#   VITE_OMNIROUTE_URL=http://localhost:20128/v1
VITE_OMNIROUTE_URL=
